# Accounts + cloud sync (Supabase). Copy to .env.local and fill in.
# Find these in your Supabase project: Settings → API.
# If these are unset, the app runs exactly as before (cloud sync is disabled,
# everything still works via localStorage).

# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / "publishable" public key (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
