# Accounts + cloud sync (Supabase). Copy to .env.local and fill in.
# Find these in your Supabase project: Settings → API.
# If these are unset, the app runs exactly as before (cloud sync is disabled,
# everything still works via localStorage).

# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / "publishable" public key (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Multi-party deal/agent collaboration layer. Off by default and decoupled from
# cloud sync: set to exactly "true" to opt in (requires Supabase keys above).
# Leave blank/unset for the unrepresented-buyer single-user experience.
NEXT_PUBLIC_DEALS_ENABLED=

# AI "auto-find comps" (issue #104). DORMANT by default — with everything below
# unset, the comps worksheet keeps showing "Auto-find comps with AI" as disabled
# / "Coming soon", exactly as before.
#
# Server key for the Anthropic Messages API (called via fetch, no SDK). Required
# for the feature to be considered configured. Leave blank to keep it off.
ANTHROPIC_API_KEY=
#
# Selects a REAL recent-sales data source for comp candidates. Set to "rentcast"
# to use the RentCast connector (issue #169); requires RENTCAST_API_KEY below.
# Without a real source there are no real candidates and we never fabricate
# comps. Leave blank to keep it off.
COMPS_DATA_SOURCE=
#
# Selects a REAL for-sale listings source for Search Homes (issue #174). Off by
# default — leave blank to serve the bundled illustrative samples
# (isSample: true). Set to "rentcast" to run search on REAL homes via the
# RentCast connector; requires RENTCAST_API_KEY below. Server-side only.
LISTINGS_DATA_SOURCE=
#
# Selects a REAL market-statistics source for the Market Conditions tool (A1 /
# ADR-013). Off by default — the tool runs on MANUAL ENTRY, which carries no
# infra risk. Set to "rentcast" to enable the gated `/v1/markets` connector
# (requires RENTCAST_API_KEY below; honored by RENTCAST_DISABLED). NOTE: the
# exact `/v1/markets` field names are an unverified spike, so the connector maps
# defensively and returns null/empty when it can't resolve a field. A SEPARATE
# var on purpose — it does NOT overload COMPS_DATA_SOURCE/LISTINGS_DATA_SOURCE.
# Server-side only.
MARKET_DATA_SOURCE=
#
# SERVER SECRET — RentCast API key (issue #169). Read server-side only; NEVER
# exposed to the browser (no NEXT_PUBLIC_ prefix) and never committed. Required
# when COMPS_DATA_SOURCE=rentcast. Leave blank to keep the connector off.
RENTCAST_API_KEY=
#
# KILL SWITCH — force ALL RentCast data sources (for-sale listings AND comps)
# back to their safe defaults (mock listings / null comps), even if the source
# vars and key above are still set. Set to "1"/"true"/"yes"/"on" to cut live
# RentCast immediately (cost spike, vendor outage, bad data); leave blank/unset
# to keep RentCast enabled. Server-side only.
RENTCAST_DISABLED=
#
# Client surface flag for the REAL auto-find button (issue #169): set to exactly
# "true" for the UI to OFFER auto-find, which POSTs the route and populates
# GENUINE comps (no sample banner). Default unset = UI stays "Coming soon". The
# server still gates independently, so this alone does not turn the feature on.
NEXT_PUBLIC_COMPS_AUTOFIND=
#
# Client surface flag (legacy AI path): set to exactly "true" for the UI to OFFER
# the "Auto-find comps with AI" button. Default unset = UI stays "Coming soon".
# The server still gates independently, so this alone does not turn it on.
NEXT_PUBLIC_AI_COMPS_ENABLED=
#
# Comps DEMO mode (issue #127). Set to exactly "true" to enable an
# "Auto-find comps (sample data)" option that runs fully client-side with
# ILLUSTRATIVE sample comps for demo/testing — no Claude key or paid data feed.
# Results are always labeled "Sample data — illustrative, not real sales".
# Default unset = off. The real AI path above takes precedence when enabled.
NEXT_PUBLIC_COMPS_DEMO=

# AI explainer (issues #36 + #57). DORMANT by default — with everything below
# unset, the offer wizard keeps showing the AI explanation as "Coming soon" and
# the budget calculator shows no AI button, exactly as before. The SAME vars power
# BOTH explainers behind one provider seam: the offer-strength explainer (#36) and
# the budget explainer (#57). No budget-specific vars are needed. PROTOTYPE/TESTING
# ONLY: each explains OUR deterministic numbers in plain English (grounded, never
# free-form — the budget explainer NARRATES the PITI/affordability figures
# `lib/budget.ts` already computed and never calculates, recommends a loan/lender,
# or quotes a rate as an offer), screens the model output for Fair-Housing safety,
# and labels every response (offer: "educational only — not legal or financial
# advice, no acceptance guarantee"; budget: "AI-generated estimate — not financial
# advice; confirm with a licensed lender"). PRODUCTION should swap to Claude Haiku
# via a `source-claude.ts` behind the same seam; legal sign-off gates going live.
#
# Provider-agnostic seam. Default blank = off; set to "gemini" to enable the
# free-tier Gemini connector. Selecting another value later is one new
# `source-*.ts` file plus a value here — nothing downstream changes.
AI_EXPLAINER_SOURCE=
#
# SERVER SECRET — Google Gemini API key, from Google AI Studio (free tier). Read
# server-side only; NEVER exposed to the browser (no NEXT_PUBLIC_ prefix), never
# logged, and never committed. Sent only as the `x-goog-api-key` request header.
# Required when AI_EXPLAINER_SOURCE=gemini. Leave blank to keep the connector off.
GEMINI_API_KEY=
#
# Gemini model id. Default "gemini-2.5-flash" when blank. Server-side only.
GEMINI_MODEL=
#
# KILL SWITCH — force the AI explainer back to its safe default (returns null /
# UI shows unavailable), even if AI_EXPLAINER_SOURCE and GEMINI_API_KEY above are
# still set. Set to "1"/"true"/"yes"/"on" to cut the live AI call immediately
# (cost spike, vendor outage, bad output, legal hold); leave blank/unset to keep
# it enabled when otherwise configured. Server-side only.
AI_EXPLAINER_DISABLED=
#
# Client surface flag (issues #36 + #57): set to exactly "true" for the offer
# wizard to OFFER the "Explain my offer's strength (AI)" action AND the budget
# calculator to OFFER the "Explain my budget (AI)" action, each of which POSTs its
# route and renders the grounded, screened, clearly-labeled explanation. Default
# unset = offer UI stays "Coming soon" and the budget AI button does not render.
# The server still gates independently, so this alone does not turn the feature on.
NEXT_PUBLIC_AI_EXPLAINER=

# Reminders (S1-R1 / ADR-014). DORMANT by default. The IN-APP reminder banner
# needs NONE of these — it runs purely client-side off the pure deriver, so deadline
# nudges work out of the box. Everything below is ONLY for true BACKGROUND Web Push
# (firing when the tab is closed) and the Vercel Cron that drives it. With all of it
# unset, the app behaves exactly as before: in-app nudges only, no push, no cron run.
# UPL: reminders are PROCESS nudges; the contract is always the source of truth.
#
# SERVER SECRET — VAPID private key for Web Push (signs push messages). Read
# server-side only; NEVER exposed to the browser, never logged, never committed.
# Required (with the public key + PUSH_ENABLED) for background push.
VAPID_PRIVATE_KEY=
#
# VAPID public key. Used by the browser to subscribe; SAFE to expose, so it is also
# read server-side here. (The browser reads it via NEXT_PUBLIC_VAPID_PUBLIC_KEY below.)
VAPID_PUBLIC_KEY=
#
# Same VAPID public key, exposed to the client so the browser can create a push
# subscription on the explicit value-first "enable notifications" gesture. Leave
# blank to keep the push prompt from ever appearing.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
#
# SERVER SECRET — shared secret the Vercel Cron route (/api/cron/reminders) checks
# on every request (Authorization: Bearer <CRON_SECRET>, or x-cron-secret). The cron
# FAILS CLOSED when unset: with no CRON_SECRET it refuses to run for anyone. Set this
# (and configure the cron in vercel.json) to enable background dispatch.
CRON_SECRET=
#
# Server-side opt-in for BACKGROUND Web Push. Set to "1"/"true"/"yes"/"on" to allow
# push dispatch (requires both VAPID keys). Default unset = push is inactive and the
# cron no-ops; the in-app banner is unaffected.
PUSH_ENABLED=
#
# Client surface flag for the push gesture: set to exactly "true" for the reminders
# UI to OFFER "turn on browser notifications" (which requests permission ONLY on that
# explicit click, never on load). Default unset = in-app-only, no prompt. The server
# still gates push independently, so this alone never turns push on.
NEXT_PUBLIC_PUSH_ENABLED=
#
# KILL SWITCH — force ALL reminder delivery (in-app deriver treated as off + push)
# back to safe defaults, even if everything above is configured. Set to
# "1"/"true"/"yes"/"on" to cut reminders immediately (bad data, runaway cron, legal
# hold); leave blank/unset to keep them enabled. Server-side only.
REMINDERS_DISABLED=
